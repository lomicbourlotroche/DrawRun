# Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# API URL - Point to your backend
# For local development:
NEXT_PUBLIC_API_URL=http://localhost:3000

# For production (VPS with HTTPS):
# NEXT_PUBLIC_API_URL=https://drawrun.fr

# For production (VPS without HTTPS):
# NEXT_PUBLIC_API_URL=http://drawrun.fr

# ============================================================================
# NOUVEAU: FIREBASE CONFIGURATION (pour l'authentification sociale)
# ============================================================================
# Configuration Firebase pour l'authentification Google/Apple côté client
# Obtenez ces valeurs depuis: https://console.firebase.google.com/project/_/settings/general

# Clé API Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key

# Domaine d'authentification Firebase
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com

# ID du projet Firebase
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id

# Bucket de stockage Firebase (optionnel)
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# ID de l'application Firebase
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

# ID du sender de messages Firebase (optionnel)
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id

# ============================================================================
# GOOGLE OAUTH CONFIGURATION (pour l'authentification directe)
# ============================================================================
# ID client Google (optionnel - si vous n'utilisez pas Firebase)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# ============================================================================
# APPLE OAUTH CONFIGURATION (pour l'authentification directe)
# ============================================================================
# ID du service Apple (optionnel - si vous n'utilisez pas Firebase)
NEXT_PUBLIC_APPLE_SERVICE_ID=com.your.app

# ============================================================================
# WEBSOCKET CONFIGURATION (pour le compteur utilisateurs en temps réel)
# ============================================================================
# URL du serveur WebSocket (par défaut: même origine que NEXT_PUBLIC_API_URL)
# NEXT_PUBLIC_WS_URL=ws://localhost:3000

# ============================================================================
# Optional: Analytics or monitoring
# ============================================================================
# NEXT_PUBLIC_ANALYTICS_ID=

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Activer/désactiver l'authentification sociale (par défaut: true)
NEXT_PUBLIC_ENABLE_SOCIAL_AUTH=true

# Activer/désactiver le compteur utilisateurs en temps réel (par défaut: true)
NEXT_PUBLIC_ENABLE_USER_COUNTER=true
