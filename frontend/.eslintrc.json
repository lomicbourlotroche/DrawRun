{
  "extends": [
    "next/core-web-vitals",
    "eslint:recommended"
  ],
  "rules": {
    "no-console": ["warn", { "allow": ["error"] }],
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    "prefer-const": "error",
    "no-var": "error",
    "eqeqeq": ["error", "always"],
    "curly": ["error", "multi-line"],
    "no-throw-literal": "error"
  },
  "overrides": [
    {
      "files": ["*.test.ts", "*.test.tsx", "tests/**/*.ts", "tests/**/*.tsx"],
      "rules": {
        "no-console": "off"
      },
      "globals": {
        "React": "readonly"
      }
    }
  ]
}