# DRAWRUN CONFIGURATION - Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values

# ============================================================================
# SERVER
# ============================================================================
PORT=3000
NODE_ENV=development

# ============================================================================
# DATABASE
# ============================================================================
# SQLite (default for per-user database architecture)
# DrawRun-Data is located at the project root (sibling to backend/ and frontend/)
DATA_DIR=../../DrawRun-Data

# For production, you can use PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/drawrun

# ============================================================================
# SECURITY - CRITICAL
# ============================================================================

# JWT Secret - MUST be set in production!
# Generate with: openssl rand -base64 64
JWT_SECRET=your-jwt-secret-here-generate-with-openssl

# Credentials Encryption Secret
# Generate with: openssl rand -base64 32
CREDENTIALS_SECRET=your-encryption-secret-here
# Optional: PBKDF2 salt for credential encryption (defaults to project-specific value)
# CREDENTIALS_SALT=your-custom-salt-here

# Bcrypt rounds for password hashing (higher = safer but slower)
BCRYPT_ROUNDS=12

# ============================================================================
# NOUVEAU: FIREBASE CONFIGURATION (pour l'authentification sociale)
# ============================================================================
# Configuration Firebase Admin pour l'authentification Google/Apple
# Obtenez ces valeurs depuis: https://console.firebase.google.com/project/_/settings/serviceaccounts/adminsdk
# REQUIRED pour l'authentification sociale

# ID du projet Firebase
FIREBASE_PROJECT_ID=your-firebase-project-id

# Email du compte de service Firebase
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project-id.iam.gserviceaccount.com

# Clé privée Firebase (remplacez \\n par des sauts de ligne réels)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"

# ============================================================================
# CORS
# ============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3001,https://drawrun.fr,https://staging.drawrun.fr

# ============================================================================
# RATE LIMITING
# ============================================================================
# Requests per 15 minutes
API_RATE_LIMIT=100
AUTH_RATE_LIMIT=5

# ============================================================================
# STRAVA OAUTH2 (Official API)
# ============================================================================
# Get credentials at: https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your-strava-client-id
STRAVA_CLIENT_SECRET=your-strava-client-secret
STRAVA_CALLBACK_URL=http://localhost:3001/auth/strava/callback

# ============================================================================
# GARMIN (credentials-based)
# ============================================================================
# For direct sync (less secure - consider OAuth when available)
# GARMIN_USERNAME=your-garmin-username
# GARMIN_PASSWORD=your-garmin-password

# ============================================================================
# SUUNTO
# ============================================================================
SUUNTO_USERNAME=your-suunto-username
SUUNTO_PASSWORD=your-suunto-password

# ============================================================================
# DECATHLON (Official API - PKCE Flow)
# ============================================================================
# Get credentials at: https://developers.decathlon.com
# DECATHLON_CLIENT_ID=your-decathlon-client-id
# DECATHLON_CLIENT_SECRET=your-decathlon-client-secret
# DECATHLON_REDIRECT_URI=http://localhost:3001/auth/decathlon/callback
# DECATHLON_API_KEY=your-decathlon-api-key

# ============================================================================
# SMTP (Email)
# ============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@drawrun.fr

# ============================================================================
# BACKUP
# ============================================================================
# Backup retention (days)
BACKUP_RETENTION_DAYS=30
# Backup schedule (cron format)
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=info
LOG_DIR=./logs

# ============================================================================
# 2FA (TOTP)
# ============================================================================
# Issuer for TOTP codes
TOTP_ISSUER=DrawRun

# ============================================================================
# PERFORMANCE
# ============================================================================
# Enable Redis for caching (optional but recommended for production)
# REDIS_URL=redis://localhost:6379

# ============================================================================
# MONITORING
# ============================================================================
# Enable Prometheus metrics
ENABLE_METRICS=true

# ============================================================================
# DEPLOYMENT (for CI/CD)
# ============================================================================
# SSH for deployment
# SSH_PRIVATE_KEY=ssh-private-key
# KNOWN_HOSTS=server1.com,server2.com

# Database for migrations
# DATABASE_URL=postgresql://user:password@host:5432/drawrun

# ============================================================================
# PUSH NOTIFICATIONS (Web Push / VAPID)
# ============================================================================
# Generate VAPID keys with: npx web-push generate-vapid-keys
# Or leave empty to auto-generate on startup (not recommended for production)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@drawrun.fr

# ============================================================================
# GITHUB WEBHOOK (Auto-deploy)
# ============================================================================
# Must match the secret configured in GitHub webhook settings
WEBHOOK_SECRET=Drawrun
