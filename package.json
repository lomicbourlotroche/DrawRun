{
  "name": "drawrun-monorepo",
  "version": "3.0.0",
  "description": "DrawRun - Application de Performance Sportive",
  "private": true,
  "scripts": {
    "assistant": "node scripts/assistant.js",
    "dev": "concurrently \"cd backend && npm run dev\" \"cd frontend && npm run dev\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "install:all": "cd backend && npm install && cd ../frontend && npm install",
    "test": "cd backend && npm test && cd ../frontend && npm test",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm test",
    "lint": "cd backend && npm run lint && cd ../frontend && npm run lint",
    "lint:backend": "cd backend && npm run lint",
    "lint:frontend": "cd frontend && npm run lint",
    "format": "cd backend && npm run format && cd ../frontend && npm run format",
    "format:backend": "cd backend && npm run format",
    "format:frontend": "cd frontend && npm run format",
    "prepare": "husky install",
    "clean": "rm -rf backend/node_modules frontend/node_modules backend/data/*.db frontend/.next",
    "changelog": "node scripts/generate-changelog.js",
    "version:bump": "node scripts/bump-version.js",
    "security:audit": "node scripts/security-audit.js",
    "health-check": "npm run lint && npm run test && npm run security:audit",
    "start:prod": "pm2 start ecosystem.config.js --env production",
    "stop:prod": "pm2 stop ecosystem.config.js",
    "restart:prod": "pm2 restart ecosystem.config.js",
    "logs": "pm2 logs",
    "deploy": "bash scripts/deploy.sh"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2"
  },
  "lint-staged": {
    "backend/**/*.{js,ts}": [
      "cd backend && npm run lint:fix",
      "cd backend && npm run format"
    ],
    "frontend/**/*.{ts,tsx}": [
      "cd frontend && npm run lint",
      "cd frontend && npm run format"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "fit-file-parser": "^3.0.1",
    "multer": "^2.1.1",
    "xmldom": "^0.6.0"
  }
}
